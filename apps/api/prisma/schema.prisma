  studentId      String    @db.Uuid
  routeId        String    @db.Uuid
  stopId         String    @db.Uuid
  vehicleId      String?   @db.Uuid
  effectiveFrom  DateTime  @db.Date
  effectiveTo    DateTime? @db.Date
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  student      Student          @relation(fields: [studentId], references: [id], onDelete: Restrict)
  route        TransportRoute   @relation(fields: [routeId], references: [id], onDelete: Restrict)
  stop         TransportStop    @relation(fields: [stopId], references: [id], onDelete: Restrict)
  vehicle      TransportVehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  @@index([organizationId, studentId])
  @@index([organizationId, routeId])
  @@index([organizationId, vehicleId])
}
