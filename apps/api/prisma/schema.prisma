generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum InstitutionType {
  SCHOOL
  COLLEGE
  INSTITUTE
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum DepartmentStatus {
  ACTIVE
  INACTIVE
}

enum ClassStatus {
  ACTIVE
  INACTIVE
}

enum EmploymentStatus {
  ACTIVE
  OFFBOARDING
  OFFBOARDED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  ON_LEAVE
  HOLIDAY
  WEEK_OFF
}

enum LeaveRequestStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum HalfDayPart {
  FIRST_HALF
  SECOND_HALF
}

enum NotificationChannel {
  IN_APP
  EMAIL
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum ComplaintCategory {
  ELECTRICAL
  PLUMBING
  FURNITURE
  IT
  CLEANING
  SECURITY
  OTHER
}

enum ComplaintPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ComplaintStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CLOSED
}

enum NoticeStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum NoticeAudienceType {
  ENTIRE_ORGANIZATION
  STAFF
  DEPARTMENT
  STUDENT
  PARENT
}

enum VisitorStatus {
  CHECKED_IN
  CHECKED_OUT
}

enum VisitorHistoryEvent {
  CHECKED_IN
  CHECKED_OUT
}

enum AssetCategoryStatus {
  ACTIVE
  INACTIVE
}

enum AssetStatus {
  AVAILABLE
  ASSIGNED
  UNDER_MAINTENANCE
  RETIRED
}

enum MaintenanceType {
  REPAIR
  SERVICE
  INSPECTION
  OTHER
}

enum AssetHistoryEvent {
  CREATED
  ASSIGNED
  UNASSIGNED
  TRANSFERRED
  MAINTENANCE_STARTED
  MAINTENANCE_COMPLETED
  RETIRED
}

enum StudentStatus {
  ACTIVE
  INACTIVE
}

enum FeeStructureStatus {
  ACTIVE
  INACTIVE
}

enum StudentFeeStatus {
  PENDING
  PARTIALLY_PAID
  PAID
}

enum FeePaymentMethod {
  CASH
  BANK_TRANSFER
  UPI
  OTHER
}

enum DocumentType {
  BONAFIDE_CERTIFICATE
  CHARACTER_CERTIFICATE
  EXPERIENCE_LETTER
  SALARY_CERTIFICATE
  VISITOR_PASS
  STUDENT_ID_CARD
  STAFF_ID_CARD
}

enum DocumentOwnerType {
  STUDENT
  STAFF
  VISITOR
}

enum GeneratedDocumentStatus {
  GENERATED
}

enum ApprovalEntityType {
  LEAVE
  MAINTENANCE
  PURCHASE
  BUDGET
}

enum ApprovalRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ApprovalActionType {
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
}

enum ApprovalApproverType {
  ROLE
  USER
}

enum EventType {
  SPORTS_DAY
  PTM
  HOLIDAY
  EXAMINATION
  MEETING
  ANNUAL_DAY
  WORKSHOP
  COMPETITION
  EXHIBITION
}

enum EventStatus {
  DRAFT
  SCHEDULED
  COMPLETED
  ARCHIVED
  CANCELLED
}

enum EventParticipantType {
  STAFF
  STUDENT
}

model Organization {
  id        String             @id @default(uuid()) @db.Uuid
  name      String
  code      String             @unique
  institutionType InstitutionType @default(SCHOOL)
  status    OrganizationStatus @default(ACTIVE)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  settings    OrganizationSettings?
  users       User[]
  roles       Role[]
  departments Department[]
  staff       Staff[]
  attendance  StaffAttendance[]
  studentAttendance StudentAttendance[]
  sectionAttendanceSubstitutes SectionAttendanceSubstitute[]
  leaveTypes  LeaveType[]
  leaveBalances LeaveBalance[]
  leaveRequests LeaveRequest[]
  complaints  Complaint[]
  complaintHistories ComplaintHistory[]
  notices     Notice[]
  noticeAudiences NoticeAudience[]
  noticeAttachments NoticeAttachment[]
  noticeReads NoticeRead[]
  complaintAttachments ComplaintAttachment[]
  visitors    Visitor[]
  visitorHistories VisitorHistory[]
  assetCategories AssetCategory[]
  assets      Asset[]
  assetMaintenances AssetMaintenance[]
  assetTransfers AssetTransfer[]
  assetHistories AssetHistory[]
  files       File[]
  students    Student[]
  academicUnits AcademicUnit[]
  sections      Section[]
  documentTemplates DocumentTemplate[]
  generatedDocuments GeneratedDocument[]
  approvalWorkflows ApprovalWorkflow[]
  approvalRequests ApprovalRequest[]
  venues      Venue[]
  events      Event[]
  eventParticipants EventParticipant[]
  auditLogs   AuditLog[]
  notifications Notification[]
  feeStructures FeeStructure[]
  studentFees StudentFee[]
  feePayments FeePayment[]
  registrationRequests OrganizationRegistrationRequest[]
  passwordResetTokens PasswordResetToken[]
  operationalRequests OperationalRequest[]
  parentStudentLinks ParentStudentLink[]
  subscription OrganizationSubscription?
  transportRoutes TransportRoute[]
  transportStops TransportStop[]
  transportVehicles TransportVehicle[]
  transportAssignments StudentTransportAssignment[]

  @@index([status])
}

model OrganizationRegistrationRequest {
  id                        String   @id @default(uuid()) @db.Uuid
  organizationName          String
  preferredOrganizationCode String?
  institutionType           InstitutionType @default(SCHOOL)
  contactEmail              String   @unique
  contactFirstName String
  contactLastName  String
  contactPhone     String?  @unique
  address          String?
  city             String?
  state            String?
  country          String   @default("India")
  adminPasswordHash String?
  status           String   @default("PENDING")
  rejectionReason  String?
  approvedAt       DateTime?
  approvedByUserId String?  @db.Uuid
  organizationId   String?  @unique @db.Uuid
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  approvedByUser   User?        @relation("ApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  organization     Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([contactEmail])
  @@index([status])
}

model OrganizationSettings {
  id                     String   @id @default(uuid()) @db.Uuid
  organizationId         String   @unique @db.Uuid
  onboardingCompleted    Boolean  @default(true)
  timezone               String   @default("UTC")
  locale                 String   @default("en")
  dateFormat             String   @default("YYYY-MM-DD")
  attendancePolicy       Json?
  leaveConfiguration     Json?
  notificationDefaults   Json?
  documentSettings       Json?
  operationalPreferences Json?
  terminology            Json?
  logoFileId             String?  @db.Uuid
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  logoFile     File?        @relation("OrganizationLogo", fields: [logoFileId], references: [id], onDelete: SetNull)
}

model Venue {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  location       String?
  capacity       Int?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  events       Event[]

  @@unique([organizationId, name])
  @@index([organizationId, active])
}

model Event {
  id              String      @id @default(uuid()) @db.Uuid
  organizationId  String      @db.Uuid
  title           String
  description     String?
  type            EventType
  status          EventStatus @default(DRAFT)
  startAt         DateTime
  endAt           DateTime
  venueId         String      @db.Uuid
  createdByUserId String      @db.Uuid
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  archivedAt      DateTime?
  cancelledAt     DateTime?
  completedAt     DateTime?

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  venue        Venue               @relation(fields: [venueId], references: [id], onDelete: Restrict)
  createdBy    User                @relation("EventCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  participants EventParticipant[]

  @@index([organizationId, status, startAt])
  @@index([organizationId, venueId, startAt, endAt])
  @@index([organizationId, type, startAt])
}

model EventParticipant {
  id              String               @id @default(uuid()) @db.Uuid
  organizationId  String               @db.Uuid
  eventId         String               @db.Uuid
  participantType  EventParticipantType
  participantId   String               @db.Uuid
  createdAt       DateTime             @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([organizationId, eventId, participantType, participantId])
  @@index([organizationId, eventId])
  @@index([organizationId, participantType, participantId])
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  organizationId  String     @db.Uuid
  email           String
  passwordHash    String?
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  userRoles       UserRole[]
  refreshSessions RefreshSession[]
  staffProfile    Staff?
  studentProfile  Student?
  correctedAttendance StaffAttendance[] @relation("AttendanceCorrectedBy")
  decidedLeaveRequests LeaveRequest[] @relation("LeaveRequestDecidedBy")
  createdComplaints Complaint[] @relation("ComplaintCreatedBy")
  complaintHistoryEntries ComplaintHistory[] @relation("ComplaintHistoryActor")
  createdNotices Notice[] @relation("NoticeCreatedBy")
  noticeReads NoticeRead[]
  createdVisitors Visitor[] @relation("VisitorCreatedBy")
  visitorHistoryEntries VisitorHistory[] @relation("VisitorHistoryActor")
  createdAssets Asset[] @relation("AssetCreatedBy")
  assetMaintenanceEntries AssetMaintenance[] @relation("AssetMaintenanceCreatedBy")
  assetTransfers AssetTransfer[] @relation("AssetTransferredBy")
  assetHistoryEntries AssetHistory[] @relation("AssetHistoryActor")
  createdFiles File[] @relation("FileCreatedBy")
  createdDocumentTemplates DocumentTemplate[] @relation("DocumentTemplateCreatedBy")
  generatedDocuments GeneratedDocument[] @relation("GeneratedDocumentCreatedBy")
  submittedApprovalRequests ApprovalRequest[] @relation("ApprovalRequestSubmittedBy")
  approvalActions ApprovalAction[] @relation("ApprovalActionActor")
  configuredApprovalLevels ApprovalLevel[] @relation("ApprovalLevelUser")
  createdEvents Event[] @relation("EventCreatedBy")
  auditLogEntries AuditLog[] @relation("AuditLogActor")
  notifications Notification[] @relation("NotificationRecipient")
  recordedFeePayments FeePayment[] @relation("FeePaymentCreatedBy")
  approvedRegistrations OrganizationRegistrationRequest[] @relation("ApprovedBy")
  passwordResetTokens PasswordResetToken[]
  submittedOperationalRequests OperationalRequest[] @relation("OperationalRequestSubmittedBy")
  parentStudentLinks ParentStudentLink[] @relation("ParentStudentLinkParent")
  markedStudentAttendance StudentAttendance[] @relation("StudentAttendanceMarkedBy")
  createdSectionSubstitutes SectionAttendanceSubstitute[] @relation("SectionSubstituteCreatedBy")

  @@unique([organizationId, email])
  @@unique([email])
  @@index([organizationId, status])
}

model Role {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @db.Uuid
  code           String
  name           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization    Organization?    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  rolePermissions RolePermission[]
  userRoles       UserRole[]
  approvalLevels  ApprovalLevel[] @relation("ApprovalLevelRole")
  refreshSessions RefreshSession[]

  /// Organization-scoped uniqueness. Platform roles (organizationId = null) also rely on
  /// manual SQL index Role_platform_code_key — see prisma/MIGRATION-NOTES.md.
  @@unique([organizationId, code])
  @@index([organizationId])
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]
}

model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  roleId       String   @db.Uuid
  permissionId String   @db.Uuid
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@unique([roleId, permissionId])
  @@index([permissionId])
}

model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  roleId    String   @db.Uuid
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, roleId])
  @@index([roleId])
}

model RefreshSession {
  id                  String    @id @default(uuid()) @db.Uuid
  userId              String    @db.Uuid
  tokenHash           String    @unique
  expiresAt           DateTime
  revokedAt           DateTime?
  revokedReason       String?
  replacedBySessionId String?   @unique @db.Uuid
  userAgent           String?
  ipAddress           String?
  lastUsedAt          DateTime?
  activeRoleId        String?   @db.Uuid
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user       User  @relation(fields: [userId], references: [id], onDelete: Restrict)
  activeRole Role? @relation(fields: [activeRoleId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([expiresAt])
  @@index([userId, revokedAt])
  @@index([activeRoleId])
}

model PasswordResetToken {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @db.Uuid
  organizationId String    @db.Uuid
  tokenHash      String    @unique
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime  @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([expiresAt])
  @@index([userId, usedAt])
  @@index([organizationId])
}

model Department {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  name           String
  code           String
  status         DepartmentStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  staff           Staff[]
  noticeAudiences NoticeAudience[]
  assets          Asset[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
}

model Staff {
  id                 String           @id @default(uuid()) @db.Uuid
  organizationId     String           @db.Uuid
  employeeCode       String
  userId             String?          @unique @db.Uuid
  firstName          String
  lastName           String
  displayName        String?
  mobile             String?
  email              String?
  departmentId       String?          @db.Uuid
  designation        String?
  joiningDate        DateTime?
  lastWorkingDate    DateTime?
  reportingManagerId String?          @db.Uuid
  employmentStatus   EmploymentStatus @default(ACTIVE)
  photoFileId        String?          @db.Uuid
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user             User?        @relation(fields: [userId], references: [id], onDelete: Restrict)
  photoFile        File?        @relation("StaffPhoto", fields: [photoFileId], references: [id], onDelete: SetNull)
  department       Department?  @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  reportingManager Staff?       @relation("StaffReportingHierarchy", fields: [reportingManagerId], references: [id], onDelete: Restrict)
  directReports    Staff[]      @relation("StaffReportingHierarchy")
  classTeacherOf   Section[]    @relation("SectionClassTeacher")
  substituteFor    SectionAttendanceSubstitute[] @relation("SectionSubstituteStaff")
  attendance       StaffAttendance[]
  leaveBalances    LeaveBalance[]
  leaveRequests    LeaveRequest[]
  assignedComplaints Complaint[]
  hostedVisitors     Visitor[] @relation("VisitorHost")
  assignedAssets     Asset[] @relation("AssetAssignedStaff")
  drivenVehicles     TransportVehicle[] @relation("TransportVehicleDriver")

  @@unique([organizationId, employeeCode])
  @@index([organizationId, employeeCode])
  @@index([organizationId, departmentId])
  @@index([organizationId, employmentStatus])
  @@index([organizationId, reportingManagerId])
}

model StaffAttendance {
  id                    String           @id @default(uuid()) @db.Uuid
  organizationId        String           @db.Uuid
  staffId               String           @db.Uuid
  attendanceDate        DateTime         @db.Date
  checkInAt             DateTime?
  checkOutAt            DateTime?
  status                AttendanceStatus
  lateFlag              Boolean          @default(false)
  earlyDepartureFlag    Boolean          @default(false)
  remarks               String?
  correctionRequestedAt DateTime?
  correctedByUserId     String?          @db.Uuid
  correctedAt           DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  staff        Staff        @relation(fields: [staffId], references: [id], onDelete: Restrict)
  correctedBy  User?        @relation("AttendanceCorrectedBy", fields: [correctedByUserId], references: [id], onDelete: Restrict)

  @@unique([organizationId, staffId, attendanceDate])
  @@index([organizationId, attendanceDate])
  @@index([organizationId, status, attendanceDate])
  @@index([organizationId, staffId])
}

model LeaveType {
  id                 String   @id @default(uuid()) @db.Uuid
  organizationId     String   @db.Uuid
  name               String
  code               String
  description        String?
  tracksBalance      Boolean  @default(true)
  allowsHalfDay      Boolean  @default(false)
  requiresReason     Boolean  @default(false)
  requiresAttachment Boolean  @default(false)
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  balances     LeaveBalance[]
  requests     LeaveRequest[]

  @@unique([organizationId, code])
  @@index([organizationId, active])
}

model LeaveBalance {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @db.Uuid
  staffId          String   @db.Uuid
  leaveTypeId      String   @db.Uuid
  periodStart      DateTime @db.Date
  periodEnd        DateTime @db.Date
  openingBalance   Decimal  @default(0) @db.Decimal(6, 2)
  allocatedAmount  Decimal  @default(0) @db.Decimal(6, 2)
  usedAmount       Decimal  @default(0) @db.Decimal(6, 2)
  pendingAmount    Decimal  @default(0) @db.Decimal(6, 2)
  adjustmentAmount Decimal  @default(0) @db.Decimal(6, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  staff        Staff        @relation(fields: [staffId], references: [id], onDelete: Restrict)
  leaveType    LeaveType    @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)

  @@unique([organizationId, staffId, leaveTypeId, periodStart, periodEnd])
  @@index([organizationId, staffId])
  @@index([organizationId, leaveTypeId])
}

model LeaveRequest {
  id               String             @id @default(uuid()) @db.Uuid
  organizationId   String             @db.Uuid
  staffId          String             @db.Uuid
  leaveTypeId      String             @db.Uuid
  startDate        DateTime           @db.Date
  endDate          DateTime           @db.Date
  duration         Decimal            @db.Decimal(6, 2)
  halfDayPart      HalfDayPart?
  reason           String?
  attachmentFileId String?            @db.Uuid
  status           LeaveRequestStatus @default(PENDING_APPROVAL)
  submittedAt      DateTime           @default(now())
  decidedAt        DateTime?
  decidedByUserId  String?            @db.Uuid
  approvalRequestId String?           @unique @db.Uuid
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  staff          Staff        @relation(fields: [staffId], references: [id], onDelete: Restrict)
  leaveType      LeaveType    @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  decidedBy      User?        @relation("LeaveRequestDecidedBy", fields: [decidedByUserId], references: [id], onDelete: Restrict)
  attachmentFile File?        @relation("LeaveAttachment", fields: [attachmentFileId], references: [id], onDelete: SetNull)
  approvalRequest ApprovalRequest? @relation(fields: [approvalRequestId], references: [id], onDelete: SetNull)

  @@index([organizationId, staffId])
  @@index([organizationId, leaveTypeId])
  @@index([organizationId, status])
  @@index([organizationId, startDate, endDate])
}

model File {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @db.Uuid
  originalName    String
  storageKey      String   @unique
  mimeType        String
  size            Int
  checksum        String?
  extension       String?
  storageProvider String   @default("local")
  createdById     String   @db.Uuid
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization     Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy        User          @relation("FileCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  staffPhotos           Staff[]              @relation("StaffPhoto")
  leaveAttachments      LeaveRequest[]     @relation("LeaveAttachment")
  generatedDocuments    GeneratedDocument[]
  complaintAttachments  ComplaintAttachment[]
  noticeAttachments     NoticeAttachment[]
  visitorPhotos         Visitor[]            @relation("VisitorPhoto")
  organizationLogos     OrganizationSettings[] @relation("OrganizationLogo")

  @@index([organizationId, createdAt])
  @@index([organizationId, id])
}

model Student {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  userId         String?       @unique @db.Uuid
  studentCode    String
  firstName      String
  lastName       String
  displayName    String?
  dateOfBirth    DateTime?     @db.Date
  className      String?
  studentClass   String?       @map("class")
  section        String?
  rollNumber     String?
  guardianName   String?
  guardianPhone  String?
  academicYear   String?
  currentTerm    Int?
  sectionId      String?       @db.Uuid
  status         StudentStatus @default(ACTIVE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  sectionRef   Section?     @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  studentFees      StudentFee[]
  assignedAssets   Asset[]      @relation("AssetAssignedStudent")
  parentLinks      ParentStudentLink[]
  transportAssignments StudentTransportAssignment[]
  attendance       StudentAttendance[]

  @@unique([organizationId, studentCode])
  @@index([organizationId, status])
  @@index([organizationId, lastName])
  @@index([organizationId, studentClass])
  @@index([organizationId, sectionId])
}

/// Generic academic unit: Class (school), Program (college) or Course (institute).
/// Backed by the legacy "SchoolClass" table.
model AcademicUnit {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @db.Uuid
  name           String
  displayOrder   Int         @default(0)
  termCount      Int?
  status         ClassStatus @default(ACTIVE)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  sections     Section[]

  @@unique([organizationId, name])
  @@index([organizationId, status])
  @@map("SchoolClass")
}

model Section {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @db.Uuid
  classId        String      @db.Uuid
  name           String
  classTeacherId String?     @db.Uuid
  capacity       Int?
  status         ClassStatus @default(ACTIVE)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  academicUnit AcademicUnit @relation(fields: [classId], references: [id], onDelete: Restrict)
  classTeacher Staff?       @relation("SectionClassTeacher", fields: [classTeacherId], references: [id], onDelete: SetNull)
  students     Student[]
  studentAttendance     StudentAttendance[]
  attendanceSubstitutes SectionAttendanceSubstitute[]

  @@unique([classId, name])
  @@index([organizationId, status])
  @@index([classTeacherId])
}

model StudentAttendance {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  studentId      String           @db.Uuid
  /// Section the student belonged to on the attendance date.
