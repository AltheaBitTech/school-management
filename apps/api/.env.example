NODE_ENV=development
PORT=3001
# Local dev / traditional Postgres: DATABASE_URL and DIRECT_URL are the same.
# Supabase in production: DATABASE_URL = pooled connection (port 6543, ?pgbouncer=true),
# DIRECT_URL = direct connection (port 5432, used only by `prisma migrate deploy`).
DATABASE_URL=postgresql://campusops:campusops@localhost:5432/campusops?schema=public
DIRECT_URL=postgresql://campusops:campusops@localhost:5432/campusops?schema=public
CORS_ORIGIN=http://localhost:3000
JWT_ACCESS_SECRET=dev-only-change-me-use-a-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
FILE_STORAGE_ROOT=storage/files

# Email provider: 'console' (logs to API stdout — Vercel → Functions → Logs) or 'resend'.
# With console, RESEND_* are not required. Signup/reset links still appear in those logs.
EMAIL_PROVIDER=console
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Storage provider: 'local' (default, filesystem — dev only) or 'supabase' (production).
STORAGE_PROVIDER=local
# Required only when STORAGE_PROVIDER=supabase — use the Supabase project's service role key
# (server-side only, never exposed to the frontend) and a private (non-public) storage bucket.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=
