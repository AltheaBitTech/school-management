NODE_ENV=development
PORT=3001
# Local dev / traditional Postgres: DATABASE_URL and DIRECT_URL are the same.
# Supabase in production: DATABASE_URL = pooled connection (port 6543, ?pgbouncer=true),
# DIRECT_URL = direct connection (port 5432, used only by `prisma migrate deploy`).
DATABASE_URL=postgresql://campusops:campusops@localhost:5432/campusops?schema=public
DIRECT_URL=postgresql://campusops:campusops@localhost:5432/campusops?schema=public
# Allowed browser origins (comma-separated). Use * for one path segment (Vercel preview URLs).
# First non-wildcard entry = links in emails (signup, reset password).
# Example: production web URL + all Vercel previews for the WEB project.
# Use school-management-* (not school-management-ui-*) if previews look like
# https://school-management-<hash>-<team>.vercel.app
# CORS_ORIGIN=https://school-management-ui-ivory.vercel.app,https://school-management-*.vercel.app
CORS_ORIGIN=http://localhost:3000
JWT_ACCESS_SECRET=dev-only-change-me-use-a-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Centrally disable staff attendance UI and APIs (true | false). Default: true when unset.
FEATURE_ATTENDANCE_ENABLED=true

# Vercel Cron: Bearer token for GET /cron/* (set in Vercel project env; omit in local dev to skip guard)
CRON_SECRET=

# Email provider: 'console' (logs to API stdout) or 'resend' (delivers mail).
# Read at startup. A change on Vercel needs a redeploy.
# With console, RESEND_* are not required. Signup/reset links appear in the API logs.
# RESEND_FROM_EMAIL may be an address or "Display Name <address>" on a verified domain.
EMAIL_PROVIDER=console
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Optional reply-to address.
EMAIL_REPLY_TO=
# Optional absolute web origin used in email links. Falls back to the first CORS_ORIGIN entry.
FRONTEND_URL=

# Storage provider: 'local' (default, filesystem — dev only) or 'supabase' (production).
STORAGE_PROVIDER=local
# Required only when STORAGE_PROVIDER=supabase — use the Supabase project's service role key
# (server-side only, never exposed to the frontend) and a private (non-public) storage bucket.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=
