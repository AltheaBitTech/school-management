{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm vercel-build",
  "installCommand": "pnpm install --frozen-lockfile",
  "outputDirectory": "public",
  "functions": {
    "api/index.ts": {
      "includeFiles": "node_modules/.prisma/client/**,node_modules/pdfkit/**,node_modules/fontkit/**,dist/common/pdf/standard-fonts/**,apps/api/dist/common/pdf/standard-fonts/**"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }]
}
