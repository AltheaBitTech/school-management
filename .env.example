# PostgreSQL (docker-compose defaults)
POSTGRES_USER=campusops
POSTGRES_PASSWORD=campusops
POSTGRES_DB=campusops
POSTGRES_PORT=5432

# Backend (apps/api) — copy to apps/api/.env for local development
DATABASE_URL=postgresql://campusops:campusops@localhost:5432/campusops?schema=public
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:3000
JWT_ACCESS_SECRET=dev-only-change-me-use-a-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Platform administrator bootstrap (apps/api) — run: pnpm bootstrap:platform-admin
PLATFORM_ADMIN_EMAIL=platform-admin@example.com
PLATFORM_ADMIN_PASSWORD=ChangeMePlatformAdmin123!

# Frontend (apps/web) — copy to apps/web/.env.local for local development
NEXT_PUBLIC_API_URL=http://localhost:3001
